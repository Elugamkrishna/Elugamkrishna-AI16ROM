name: AI14ROM Delta Generator Final

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build delta_generator
    runs-on: ubuntu-24.04

    steps:

      # ============================================================
      # 01. CHECKOUT
      # ============================================================

      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      # ============================================================
      # 02. VERIFY REPOSITORY
      # ============================================================

      - name: Verify repository
        shell: bash
        run: |
          set -euxo pipefail

          echo "========================================"
          echo " AI14ROM DELTA GENERATOR"
          echo " ANDROID 14 HOST BUILD"
          echo "========================================"

          git rev-parse HEAD
          git log -1 --oneline

          test -d ota_tool
          test -d ota_tool/full_build
          test -f ota_tool/full_build/CMakeLists.txt
          test -f ota_tool/update_engine/scripts/brillo_update_payload

          echo
          echo "REPOSITORY OK"

      # ============================================================
      # 03. BUILD DEPENDENCIES
      # ============================================================

      - name: Install build dependencies
        shell: bash
        run: |
          set -euxo pipefail

          sudo apt-get update

          sudo apt-get install -y \
            build-essential \
            clang \
            lld \
            cmake \
            ninja-build \
            pkg-config \
            git \
            curl \
            wget \
            rsync \
            unzip \
            zip \
            python3 \
            python3-pip \
            libssl-dev \
            libevent-dev \
            liblz4-dev \
            liblzma-dev \
            libzstd-dev \
            zlib1g-dev \
            libbz2-dev \
            libbrotli-dev \
            libgflags-dev \
            libgtest-dev \
            libext2fs-dev

          echo
          echo "========================================"
          echo "BUILD DEPENDENCIES READY"
          echo "========================================"

          clang --version | head -1
          cmake --version | head -1
          ninja --version

          echo
          echo "EXT2FS:"
          dpkg -s libext2fs-dev | grep '^Version:'

      # ============================================================
      # 04. OTA DEPENDENCIES
      # ============================================================

      - name: Prepare OTA dependencies
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool

          mkdir -p deps

          clone_branch() {
            name="$1"
            branch="$2"
            url="$3"

            echo
            echo "========================================"
            echo "CLONE: $name"
            echo "BRANCH: $branch"
            echo "========================================"

            rm -rf "deps/$name"

            git clone \
              --depth=1 \
              --branch "$branch" \
              "$url" \
              "deps/$name"
          }

          clone_main() {
            name="$1"
            url="$2"

            echo
            echo "========================================"
            echo "CLONE: $name"
            echo "========================================"

            rm -rf "deps/$name"

            git clone \
              --depth=1 \
              "$url" \
              "deps/$name"
          }

          # --------------------------------------------------------
          # ANDROID 14 PLATFORM DEPENDENCIES
          # --------------------------------------------------------

          clone_branch \
            libbase \
            android14-release \
            https://android.googlesource.com/platform/system/libbase

          clone_branch \
            libchrome \
            android14-release \
            https://android.googlesource.com/platform/external/libchrome

          clone_branch \
            libbrillo \
            android14-release \
            https://android.googlesource.com/platform/external/libbrillo

          clone_branch \
            system_core \
            android14-release \
            https://android.googlesource.com/platform/system/core

          clone_branch \
            system_extras \
            android14-release \
            https://android.googlesource.com/platform/system/extras

          clone_branch \
            external_avb \
            android14-release \
            https://android.googlesource.com/platform/external/avb

          # --------------------------------------------------------
          # GENERIC OTA DEPENDENCIES
          # --------------------------------------------------------

          clone_main \
            gflags \
            https://android.googlesource.com/platform/external/gflags

          clone_main \
            googletest \
            https://android.googlesource.com/platform/external/googletest

          clone_main \
            puffin \
            https://android.googlesource.com/platform/external/puffin

          clone_main \
            bsdiff \
            https://android.googlesource.com/platform/external/bsdiff

          clone_main \
            zucchini \
            https://android.googlesource.com/platform/external/zucchini

          # IMPORTANT:
          # update_engine expects the older EROFS API.
          # Android 14 r61 upgraded erofs-utils to v1.7.1.
          clone_branch \
            erofs-utils \
            android-14.0.0_r61 \
            https://android.googlesource.com/platform/external/erofs-utils

          clone_main \
            lzma \
            https://android.googlesource.com/platform/external/lzma

          echo
          echo "========================================"
          echo "DEPENDENCY VERIFICATION"
          echo "========================================"

          for d in \
            libbase \
            libchrome \
            libbrillo \
            system_core \
            system_extras \
            external_avb \
            gflags \
            googletest \
            puffin \
            bsdiff \
            zucchini \
            erofs-utils \
            lzma
          do
            test -d "deps/$d"
            echo "OK: deps/$d"
          done

          test -d deps/external_avb/libavb
          test -d deps/external_avb/libavb/sha

          test -f deps/erofs-utils/include/erofs/internal.h
          test -f deps/erofs-utils/include/erofs/io.h
          test -f deps/erofs-utils/lib/io.c
          test -f deps/erofs-utils/lib/super.c

          echo
          echo "========================================"
          echo "EROFS VERSION"
          echo "========================================"

          git -C deps/erofs-utils describe --tags --always || true

          echo
          echo "EROFS ANDROID 14 SOURCE VERIFIED"

          echo
          echo "ANDROID 14 DEPENDENCIES READY"

          echo
          echo "LIBCHROME:"
          git -C deps/libchrome rev-parse --short HEAD

          echo
          echo "LIBBRILLO:"
          git -C deps/libbrillo rev-parse --short HEAD

          echo
          echo "LIBBASE:"
          git -C deps/libbase rev-parse --short HEAD

          echo
          echo "AVB:"
          git -C deps/external_avb rev-parse --short HEAD

          echo
          echo "EROFS:"
          git -C deps/erofs-utils rev-parse --short HEAD

      # ============================================================
      # 05. GFLAGS
      # ============================================================

      - name: Build gflags
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool

          rm -rf gflags_build
          rm -rf deps/gflags_install

          cmake \
            -S deps/gflags \
            -B gflags_build \
            -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DBUILD_SHARED_LIBS=OFF \
            -DGFLAGS_BUILD_TESTING=OFF \
            -DCMAKE_INSTALL_PREFIX="$PWD/deps/gflags_install"

          cmake \
            --build gflags_build \
            --parallel 2

          cmake \
            --build gflags_build \
            --target install

          test -f \
            deps/gflags_install/lib/libgflags.a

          echo
          echo "GFLAGS OK"

          ls -lh \
            deps/gflags_install/lib/libgflags.a

      # ============================================================
      # 06. PROTOBUF 7.35.1
      # ============================================================

      - name: Build Protobuf 7.35.1
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool

          rm -rf deps/protobuf
          rm -rf protobuf_build
          rm -rf deps/protobuf_install

          echo
          echo "========================================"
          echo "PROTOBUF v35.1"
          echo "========================================"

          git clone \
            --depth=1 \
            --branch v35.1 \
            https://github.com/protocolbuffers/protobuf.git \
            deps/protobuf

          cmake \
            -S deps/protobuf \
            -B protobuf_build \
            -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -Dprotobuf_BUILD_TESTS=OFF \
            -Dprotobuf_BUILD_SHARED_LIBS=OFF \
            -Dprotobuf_BUILD_LIBPROTOC=ON \
            -Dprotobuf_BUILD_PROTOC_BINARIES=ON \
            -DCMAKE_INSTALL_PREFIX="$PWD/deps/protobuf_install"

          cmake \
            --build protobuf_build \
            --parallel 2

          cmake \
            --build protobuf_build \
            --target install

          test -x \
            deps/protobuf_install/bin/protoc

          test -f \
            deps/protobuf_install/lib/libprotobuf.a

          test -f \
            deps/protobuf_install/include/google/protobuf/runtime_version.h

          echo
          echo "PROTOC:"
          deps/protobuf_install/bin/protoc --version

          deps/protobuf_install/bin/protoc --version \
            | grep -q "35.1"

          grep -q \
            "7035001" \
            deps/protobuf_install/include/google/protobuf/runtime_version.h

          echo
          echo "PROTOBUF 7.35.1 OK"

      # ============================================================
      # 07. EROFS HOST CONFIG
      # ============================================================

      - name: Prepare EROFS
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool

          mkdir -p deps/erofs-utils/include

          cat > deps/erofs-utils/include/config.h <<'EOF'
          #pragma once

          #define PACKAGE_VERSION "1.7.1"
          #define HAVE_MEMRCHR 1
          #define HAVE_MKSTEMP 1
          #define HAVE_FTRUNCATE 1
          #define HAVE_PREAD 1
          #define HAVE_PWRITE 1
          #define HAVE_POSIX_FALLOCATE 1
          #define HAVE_LZ4 1
          #define HAVE_LZMA 1
          #define HAVE_LIBLZ4 1
          EOF

          echo
          echo "EROFS CONFIG OK"

      # ============================================================
      # 08. HOST COMPATIBILITY PATCHES
      # ============================================================

      - name: Prepare Android 14 host build
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool/full_build

          echo
          echo "========================================"
          echo "ANDROID 14 HOST BUILD PATCH"
          echo "========================================"

          python3 - <<'PY'
          from pathlib import Path
          import re

          cmake = Path("CMakeLists.txt")
          s = cmake.read_text()

          # --------------------------------------------------------
          # FIX 01
          # malformed include_directories
          # --------------------------------------------------------

          s = s.replace(
              'include_directories(\ninclude_directories("../deps/fec")',
              'include_directories(\n  "../deps/fec"',
              1
          )

          # --------------------------------------------------------
          # FIX 02
          # generated protobuf
          # --------------------------------------------------------

          if 'set(GENERATED_PROTO\n)' in s:
              s = s.replace(
                  'set(GENERATED_PROTO\n)',
                  '''set(GENERATED_PROTO
            "${GEN}/update_engine/update_metadata.pb.cc"
            "${GEN}/lz4diff/lz4diff.pb.cc"
          )''',
                  1
              )
          elif 'update_metadata.pb.cc' not in s:
              marker = 'set(GENERATED_PROTO'
              pos = s.find(marker)
              if pos == -1:
                  raise SystemExit("GENERATED_PROTO block missing")

          # --------------------------------------------------------
          # FIX 03
          # AVB exact Android 14 source set
          # --------------------------------------------------------

          avb_marker = "  # AVB\n"
          avb_start = s.find(avb_marker)

          if avb_start == -1:
              raise SystemExit("AVB block not found")

          avb_end = s.find(
              "\n)\n\nset(GENERATED_PROTO",
              avb_start
          )

          if avb_end == -1:
              raise SystemExit("AVB block end not found")

          avb_files = [
              "avb_chain_partition_descriptor.c",
              "avb_cmdline.c",
              "avb_crc32.c",
              "avb_crypto.c",
              "avb_descriptor.c",
              "avb_footer.c",
              "avb_hash_descriptor.c",
              "avb_hashtree_descriptor.c",
              "avb_kernel_cmdline_descriptor.c",
              "avb_property_descriptor.c",
              "avb_rsa.c",
              "avb_slot_verify.c",
              "avb_sysdeps_posix.c",
              "avb_util.c",
              "avb_vbmeta_image.c",
              "avb_version.c",
          ]

          avb_lines = [
              "  # AVB Android 14 SHA backend"
          ]

          for name in avb_files:
              src = Path("../deps/external_avb/libavb") / name
              if not src.exists():
                  raise SystemExit(
                      f"Missing AVB source: {src}"
                  )

              avb_lines.append(
                  f'  "${{ROOT}}/deps/external_avb/libavb/{name}"'
              )

          for name in [
              "sha256_impl.c",
              "sha512_impl.c",
          ]:
              src = Path("../deps/external_avb/libavb/sha") / name
              if not src.exists():
                  raise SystemExit(
                      f"Missing AVB SHA source: {src}"
                  )

              avb_lines.append(
                  f'  "${{ROOT}}/deps/external_avb/libavb/sha/{name}"'
              )

          new_avb = "\n".join(avb_lines)

          s = (
              s[:avb_start]
              + new_avb
              + s[avb_end:]
          )

          # --------------------------------------------------------
          # FIX 04
          # remove BoringSSL AVB include
          # --------------------------------------------------------

          s = re.sub(
              r'\ninclude_directories\("\$\{CMAKE_SOURCE_DIR\}/\.\./deps/external_avb/libavb/boringssl".*?\)\n?',
              "\n",
              s
          )

          # --------------------------------------------------------
          # FIX 05
          # add SHA include
          # --------------------------------------------------------

          if (
              '"${ROOT}/deps/external_avb/libavb/sha"'
              not in s
          ):
              s = s.replace(
                  '"${ROOT}/deps/external_avb/libavb"\n',
                  '"${ROOT}/deps/external_avb/libavb"\n'
                  '  "${ROOT}/deps/external_avb/libavb/sha"\n',
                  1
              )

          # --------------------------------------------------------
          # FIX 06
          # add complete EROFS library sources
          #
          # Android's liberofs builds lib/*.c with selected
          # exclusions. This prevents later dev_open_ro /
          # erofs_read_superblock linker failures.
          # --------------------------------------------------------

          erofs_marker = "  # EROFS\n"

          erofs_start = s.find(erofs_marker)

          if erofs_start == -1:
              raise SystemExit("EROFS block not found")

          erofs_end = s.find(
              "\n\n  # AVB",
              erofs_start
          )

          if erofs_end == -1:
              raise SystemExit("EROFS block end not found")

          erofs_dir = Path("../deps/erofs-utils/lib")

          erofs_sources = sorted(
              p for p in erofs_dir.glob("*.c")
              if p.name not in {
                  "compressor_libdeflate.c",
                  "compressor_libzstd.c",
                  "workqueue.c",
              }
          )

          if not erofs_sources:
              raise SystemExit(
                  "No EROFS library sources found"
              )

          erofs_lines = [
              "  # EROFS Android 14 v1.7.1"
          ]

          for src in erofs_sources:
              erofs_lines.append(
                  f'  "${{ROOT}}/deps/erofs-utils/lib/{src.name}"'
              )

          new_erofs = "\n".join(erofs_lines)

          s = (
              s[:erofs_start]
              + new_erofs
              + s[erofs_end:]
          )

          # --------------------------------------------------------
          # FIX 07
          # Android host macro
          # --------------------------------------------------------

          if "__ANDROID_HOST__" not in s:
              marker = "target_compile_definitions(delta_generator PRIVATE"
              pos = s.find(marker)

              if pos == -1:
                  raise SystemExit(
                      "target_compile_definitions missing"
                  )

              close = s.find(")", pos)

              if close == -1:
                  raise SystemExit(
                      "target_compile_definitions end missing"
                  )

              s = (
                  s[:close]
                  + "  __ANDROID_HOST__\n"
                  + s[close:]
              )

          # --------------------------------------------------------
          # FIX 08
          # host libchrome MessagePump sources
          # --------------------------------------------------------

          message_sources = [
              "base/message_loop/incoming_task_queue.cc",
              "base/message_loop/message_loop.cc",
              "base/message_loop/message_loop_current.cc",
              "base/message_loop/message_loop_task_runner.cc",
              "base/message_loop/message_pump.cc",
              "base/message_loop/message_pump_default.cc",
              "base/message_loop/message_pump_libevent.cc",
              "base/message_loop/watchable_io_message_pump_posix.cc",

              "base/files/file.cc",
              "base/files/file_posix.cc",
              "base/files/file_util_posix.cc",

              "base/memory/ref_counted.cc",
              "base/memory/ref_counted_memory.cc",
              "base/memory/shared_memory_posix.cc",
              "base/memory/shared_memory_handle_posix.cc",
              "base/memory/shared_memory_helper.cc",
              "base/memory/memory_mapped_file.cc",
              "base/memory/memory_mapped_file_posix.cc",

              "base/lazy_instance_helpers.cc",
              "base/pending_task.cc",
              "base/run_loop.cc",
              "base/sequence_checker_impl.cc",
              "base/sequence_token.cc",
              "base/sequenced_task_runner.cc",

              "base/synchronization/atomic_flag.cc",
              "base/synchronization/condition_variable_posix.cc",
              "base/synchronization/lock.cc",

              "base/debug/alias.cc",
              "base/debug/debugger.cc",
              "base/debug/debugger_posix.cc",

              "base/native_library.cc",
              "base/native_library_posix.cc",

              "base/process/process_handle.cc",
              "base/process/process_handle_posix.cc",
              "base/process/process_handle_linux.cc",
              "base/process/process_posix.cc",
              "base/process/kill.cc",
              "base/process/kill_posix.cc",
              "base/process/memory.cc",
              "base/process/process_iterator.cc",
              "base/process/process_iterator_linux.cc",
              "base/process/process_metrics.cc",
              "base/process/process_metrics_posix.cc",
              "base/process/process_metrics_linux.cc",
              "base/process/internal_linux.cc",
              "base/process/process_info_linux.cc",

              "base/files/file_path_watcher_linux.cc",
              "base/files/file_util_linux.cc",
              "base/sys_info_linux.cc",

              "base/posix/file_descriptor_shuffle.cc",
              "base/posix/global_descriptors.cc",
              "base/rand_util_posix.cc",
              "base/sync_socket_posix.cc",
          ]

          anchor = (
              '  "${ROOT}/deps/libchrome/base/location.cc"\n'
          )

          if anchor not in s:
              raise SystemExit(
                  "libchrome source anchor missing"
              )

          additions = ""

          for src in message_sources:
              path = Path("../deps/libchrome") / src

              if path.exists():
                  cmake_path = (
                      '${ROOT}/deps/libchrome/' + src
                  )

                  if cmake_path not in s:
                      additions += (
                          f'  "{cmake_path}"\n'
                      )

          s = s.replace(
              anchor,
              anchor + additions,
              1
          )

          # --------------------------------------------------------
          # FIX 09
          # remove redundant local itoa object if present
          # --------------------------------------------------------

          s = s.replace(
              '  "${CMAKE_SOURCE_DIR}/../shim/itoa_fix.cc"\n',
              ''
          )

          # --------------------------------------------------------
          # FIX 10
          # secure_blob uint8_t visibility
          # --------------------------------------------------------

          secure_blob = (
              Path("../deps/libbrillo/brillo/secure_blob.h")
          )

          if secure_blob.exists():
              text = secure_blob.read_text()

              if "#include <cstdint>" not in text:
                  text = text.replace(
                      "#pragma once",
                      "#pragma once\n\n#include <cstdint>",
                      1
                  )

              secure_blob.write_text(text)

          # --------------------------------------------------------
          # FIX 11
          # libbase posix_strerror_r host ABI
          # --------------------------------------------------------

          strerror_file = (
              Path("../deps/libbase/posix_strerror_r.cpp")
          )

          if strerror_file.exists():
              strerror_file.write_text(r'''
          #include <errno.h>
          #include <stdio.h>
          #include <string.h>

          extern "C" int posix_strerror_r(
              int errnum,
              char* buf,
              size_t buflen) {
            if (buf == nullptr || buflen == 0) {
              return EINVAL;
            }

          #if defined(_WIN32)
            return strerror_s(buf, buflen, errnum);
          #elif defined(__GLIBC__)
            char* result = strerror_r(errnum, buf, buflen);

            if (result == nullptr) {
              if (buflen > 0) {
                buf[0] = '\0';
              }
              return EINVAL;
            }

            if (result != buf) {
              snprintf(buf, buflen, "%s", result);
            }

            return 0;
          #else
            return strerror_r(errnum, buf, buflen);
          #endif
          }
          ''')

          # --------------------------------------------------------
          # FIX 12
          # atomic host compatibility
          # --------------------------------------------------------

          atomic = Path(
              "../deps/libchrome/base/atomicops_internals_portable.h"
          )

          if atomic.exists():
              text = atomic.read_text()

              text = text.replace(
                  "__atomic_thread_fence(std::memory_order_seq_cst);",
                  "std::atomic_thread_fence(std::memory_order_seq_cst);"
              )

              atomic.write_text(text)

          # --------------------------------------------------------
          # FIX 13
          # prevent OZONE host mismatch
          # --------------------------------------------------------

          ml_current = Path(
              "../deps/libchrome/base/message_loop/"
              "message_loop_current.h"
          )

          if ml_current.exists():
              text = ml_current.read_text()

              text = text.replace(
                  "#if defined(USE_OZONE) && "
                  "!defined(OS_FUCHSIA) && !defined(OS_WIN)",
                  "#if defined(USE_OZONE) && "
                  "!defined(OS_FUCHSIA) && !defined(OS_WIN) && "
                  "!defined(AI14ROM_HOST_BUILD)"
              )

              ml_current.write_text(text)

          # --------------------------------------------------------
          # FIX 14
          # host android/log.h stub
          # --------------------------------------------------------

          stub = Path("host_stubs/android/log.h")

          stub.parent.mkdir(
              parents=True,
              exist_ok=True
          )

          stub.write_text(r'''
          #pragma once

          #include <stdarg.h>
          #include <stdio.h>

          #ifdef __cplusplus
          extern "C" {
          #endif

          #define ANDROID_LOG_UNKNOWN 0
          #define ANDROID_LOG_DEFAULT 1
          #define ANDROID_LOG_VERBOSE 2
          #define ANDROID_LOG_DEBUG 3
          #define ANDROID_LOG_INFO 4
          #define ANDROID_LOG_WARN 5
          #define ANDROID_LOG_ERROR 6
          #define ANDROID_LOG_FATAL 7
          #define ANDROID_LOG_SILENT 8

          #define LOG_ID_MAIN 0
          #define LOG_ID_RADIO 1
          #define LOG_ID_EVENTS 2
          #define LOG_ID_SYSTEM 3
          #define LOG_ID_CRASH 4
          #define LOG_ID_DEFAULT 0

          typedef struct __android_log_message {
            size_t struct_size;
            int buffer_id;
            int priority;
            const char* tag;
            const char* file;
            unsigned int line;
            const char* message;
          } __android_log_message;

          typedef void (*__android_logger_function)(
              const __android_log_message*);

          typedef void (*__android_aborter_function)(
              const char*);

          static inline int __android_log_write(
              int priority,
              const char* tag,
              const char* text) {
            (void)priority;
            fprintf(stderr, "%s: %s\n",
                    tag ? tag : "android",
                    text ? text : "");
            return 0;
          }

          static inline int __android_log_buf_print(
              int buffer_id,
              int priority,
              const char* tag,
              const char* fmt,
              ...) {
            (void)buffer_id;
            (void)priority;

            va_list ap;
            va_start(ap, fmt);

            fprintf(stderr,
                    "%s: ",
                    tag ? tag : "android");

            vfprintf(stderr, fmt, ap);
            fprintf(stderr, "\n");

            va_end(ap);

            return 0;
          }

          static inline int __android_log_is_loggable(
              int priority,
              const char* tag,
              int default_prio) {
            (void)priority;
            (void)tag;
            (void)default_prio;
            return 1;
          }

          static inline int __android_log_get_minimum_priority(void) {
            return ANDROID_LOG_VERBOSE;
          }

          static inline int __android_log_set_minimum_priority(
              int priority) {
            return priority;
          }

          static inline void __android_log_set_default_tag(
              const char* tag) {
            (void)tag;
          }

          static inline void __android_log_set_logger(
              __android_logger_function logger) {
            (void)logger;
          }

          static inline void __android_log_set_aborter(
              __android_aborter_function aborter) {
            (void)aborter;
          }

          static inline void __android_log_call_aborter(
              const char* message) {
            (void)message;
          }

          static inline void __android_log_write_log_message(
              const __android_log_message* message) {
            if (message && message->message) {
              fprintf(stderr, "%s\n", message->message);
            }
          }

          static inline void __android_log_logd_logger(
              const __android_log_message* message) {
            __android_log_write_log_message(message);
          }

          #ifdef __cplusplus
          }
          #endif
          ''')

          # --------------------------------------------------------
          # FIX 15
          # CMake include for host stubs
          # --------------------------------------------------------

          host_stub_line = (
              'include_directories('
              '"${CMAKE_SOURCE_DIR}/host_stubs")'
          )

          if host_stub_line not in s:
              s = (
                  host_stub_line
                  + "\n"
                  + s
              )

          # --------------------------------------------------------
          # FIX 16
          # event link
          # --------------------------------------------------------

          if "\n  event\n" not in s:
              s = s.replace(
                  "  pthread\n)",
                  "  pthread\n  event\n  dl\n)"
              )

          # --------------------------------------------------------
          # FIX 17
          # host compile definitions
          # --------------------------------------------------------

          if "AI14ROM_HOST_BUILD" not in s:
              s = s.replace(
                  "__ANDROID_HOST__",
                  "__ANDROID_HOST__\n"
                  "  AI14ROM_HOST_BUILD",
                  1
              )

          cmake.write_text(s)

          print("HOST COMPATIBILITY PATCH COMPLETE")
          PY

          echo
          echo "========================================"
          echo "HOST PATCH VALIDATION"
          echo "========================================"

          grep -n \
            "update_metadata.pb.cc" \
            CMakeLists.txt

          grep -n \
            "lz4diff.pb.cc" \
            CMakeLists.txt

          grep -n \
            "sha256_impl.c" \
            CMakeLists.txt

          grep -n \
            "AI14ROM_HOST_BUILD" \
            CMakeLists.txt

          grep -n \
            "message_pump_libevent.cc" \
            CMakeLists.txt

          grep -n \
            "lib/.*\\.c" \
            CMakeLists.txt \
            | head -20

          test -f \
            gen/update_engine/update_metadata.pb.cc

          test -f \
            gen/lz4diff/lz4diff.pb.cc

          test -f \
            ../deps/external_avb/libavb/sha/sha256_impl.c

          test -f \
            ../deps/external_avb/libavb/sha/sha512_impl.c

          test -f \
            ../deps/erofs-utils/lib/io.c

          test -f \
            ../deps/erofs-utils/lib/super.c

          test -f \
            host_stubs/android/log.h

          echo
          echo "HOST PATCH VERIFIED"

      # ============================================================
      # 09. COMPLETE LIBBRILLO HOST SOURCES
      # ============================================================

      - name: Complete libbrillo host sources
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool/full_build

          python3 - <<'PY'
          from pathlib import Path

          p = Path("CMakeLists.txt")
          s = p.read_text()

          sources = [
              "brillo/backoff_entry.cc",
              "brillo/errors/error.cc",
              "brillo/errors/error_codes.cc",
              "brillo/flag_helper.cc",
              "brillo/message_loops/message_loop_utils.cc",
              "brillo/mime_utils.cc",
              "brillo/osrelease_reader.cc",
              "brillo/process_information.cc",
              "brillo/secure_blob.cc",
              "brillo/syslog_logging.cc",
              "brillo/type_name_undecorate.cc",
              "brillo/url_utils.cc",
              "brillo/userdb_utils.cc",
              "brillo/value_conversion.cc",
              "brillo/streams/input_stream_set.cc",
              "brillo/streams/memory_containers.cc",
              "brillo/streams/memory_stream.cc",
              "brillo/streams/stream_errors.cc",
              "brillo/streams/stream_utils.cc",
          ]

          anchor = (
              '  "${ROOT}/deps/libbrillo/brillo/file_utils.cc"\n'
          )

          if anchor not in s:
              raise SystemExit(
                  "libbrillo anchor missing"
              )

          additions = ""

          for src in sources:
              path = Path("../deps/libbrillo") / src

              if path.exists():
                  cmake_path = (
                      '${ROOT}/deps/libbrillo/' + src
                  )

                  if cmake_path not in s:
                      additions += (
                          f'  "{cmake_path}"\n'
                      )

          s = s.replace(
              anchor,
              anchor + additions,
              1
          )

          p.write_text(s)

          print("LIBBRILLO HOST SOURCES COMPLETE")
          PY

      # ============================================================
      # 10. FINAL CMAKE AUDIT
      # ============================================================

      - name: Validate final build configuration
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool/full_build

          echo
          echo "========================================"
          echo "FINAL CONFIGURATION AUDIT"
          echo "========================================"

          if grep -n \
            "/data/data/com.termux/files/home" \
            CMakeLists.txt; then
            echo "ERROR: Termux path remains"
            exit 1
          fi

          if grep -n \
            'include_directories("../deps/fec")' \
            CMakeLists.txt; then
            echo "ERROR: malformed include remains"
            exit 1
          fi

          if grep -n \
            'external_avb/libavb/boringssl' \
            CMakeLists.txt; then
            echo "ERROR: BoringSSL AVB path remains"
            exit 1
          fi

          grep -q \
            "__ANDROID_HOST__" \
            CMakeLists.txt

          grep -q \
            "AI14ROM_HOST_BUILD" \
            CMakeLists.txt

          grep -q \
            "message_pump_libevent.cc" \
            CMakeLists.txt

          grep -q \
            "update_metadata.pb.cc" \
            CMakeLists.txt

          grep -q \
            "lz4diff.pb.cc" \
            CMakeLists.txt

          grep -q \
            "sha256_impl.c" \
            CMakeLists.txt

          grep -q \
            "erofs-utils/lib/io.c" \
            CMakeLists.txt

          grep -q \
            "erofs-utils/lib/super.c" \
            CMakeLists.txt

          grep -q \
            "install_plan.cc" \
            CMakeLists.txt

          grep -q \
            "download_action.cc" \
            CMakeLists.txt

          echo
          echo "========================================"
          echo "SOURCE COUNT"
          echo "========================================"

          grep -c \
            '  "${ROOT}/' \
            CMakeLists.txt || true

          echo
          echo "FINAL CMAKE AUDIT: OK"

      # ============================================================
      # 11. CONFIGURE
      # ============================================================

      - name: Configure delta_generator
        shell: bash
        run: |
          set -euxo pipefail

          cd ota_tool/full_build

          rm -rf clean_build

          PROTOBUF_ROOT="$PWD/../deps/protobuf_install"
          GFLAGS_ROOT="$PWD/../deps/gflags_install"

          test -f \
            "$PROTOBUF_ROOT/lib/libprotobuf.a"

          test -x \
            "$PROTOBUF_ROOT/bin/protoc"

          test -f \
            "$GFLAGS_ROOT/lib/libgflags.a"

          export PATH="$PROTOBUF_ROOT/bin:$PATH"

          export CMAKE_PREFIX_PATH="$PROTOBUF_ROOT;$GFLAGS_ROOT"

          echo
          echo "========================================"
          echo "PROTOBUF"
          echo "========================================"

          "$PROTOBUF_ROOT/bin/protoc" --version

          echo
          echo "========================================"
          echo "GFLAGS"
          echo "========================================"

          ls -lh \
            "$GFLAGS_ROOT/lib/libgflags.a"

          echo
          echo "========================================"
          echo "CMAKE CONFIGURE"
          echo "========================================"

          cmake \
            -S . \
            -B clean_build \
            -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_C_COMPILER=clang \
            -DCMAKE_CXX_COMPILER=clang++ \
            -DCMAKE_CXX_STANDARD=20 \
            -DCMAKE_CXX_FLAGS="-include cstdint -D__ANDROID_HOST__ -DAI14ROM_HOST_BUILD -UUSE_GLIB -UUSE_OZONE" \
            -DCMAKE_C_FLAGS="-D__ANDROID_HOST__ -DAI14ROM_HOST_BUILD -UUSE_GLIB -UUSE_OZONE" \
            -DCMAKE_PREFIX_PATH="$PROTOBUF_ROOT;$GFLAGS_ROOT" \
            -DProtobuf_ROOT="$PROTOBUF_ROOT" \
            -DProtobuf_DIR="$PROTOBUF_ROOT/lib/cmake/protobuf" \
            -DProtobuf_INCLUDE_DIR="$PROTOBUF_ROOT/include" \
            -DProtobuf_LIBRARY="$PROTOBUF_ROOT/lib/libprotobuf.a" \
            -DProtobuf_LITE_LIBRARY="$PROTOBUF_ROOT/lib/libprotobuf-lite.a" \
            -DProtobuf_PROTOC_EXECUTABLE="$PROTOBUF_ROOT/bin/protoc"

          echo
          echo "========================================"
          echo "CMAKE PROTOBUF RESULT"
          echo "========================================"

          grep -Ei \
            "Protobuf|PROTOBUF" \
            clean_build/CMakeCache.txt \
            | head -100 || true

          echo
          echo "========================================"
          echo "CMAKE EROFS RESULT"
          echo "========================================"

          grep -Ei \
            "EROFS|erofs" \
            clean_build/CMakeCache.txt \
            | head -50 || true

          echo
          echo "CMAKE CONFIGURE SUCCESS"

      # ============================================================
      # 12. BUILD
      # ============================================================

      - name: Build delta_generator
        shell: bash
        run: |
          set -o pipefail

          cd ota_tool/full_build

          echo
          echo "========================================"
          echo "BUILD delta_generator"
          echo "========================================"

          cmake \
            --build clean_build \
            --target delta_generator \
            --parallel 2 \
            2>&1 | tee delta_generator_build.log

      # ============================================================
      # 13. VERIFY
      # ============================================================

      - name: Verify delta_generator
        if: success()
        shell: bash
        run: |
          set -euxo pipefail

          BIN="ota_tool/full_build/clean_build/delta_generator"

          test -x "$BIN"

          echo
          echo "========================================"
          echo "DELTA GENERATOR SUCCESS"
          echo "========================================"

          ls -lh "$BIN"

          echo
          echo "FILE:"
          file "$BIN"

          echo
          echo "SHA256:"
          sha256sum "$BIN"

          echo
          echo "HELP:"
          "$BIN" --help || true

      # ============================================================
      # 14. UPLOAD SUCCESS
      # ============================================================

      - name: Upload delta_generator
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: AI14ROM-delta-generator-final
          path: |
            ota_tool/full_build/clean_build/delta_generator
            ota_tool/full_build/delta_generator_build.log
            ota_tool/full_build/CMakeLists.txt
          if-no-files-found: error
          retention-days: 30

      # ============================================================
      # 15. UPLOAD FAILURE LOG
      # ============================================================

      - name: Upload failure log
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: AI14ROM-delta-generator-final-build-log
          path: |
            ota_tool/full_build/delta_generator_build.log
            ota_tool/full_build/clean_build/CMakeCache.txt
            ota_tool/full_build/clean_build/.ninja_log
            ota_tool/full_build/CMakeLists.txt
          if-no-files-found: ignore
          retention-days: 14

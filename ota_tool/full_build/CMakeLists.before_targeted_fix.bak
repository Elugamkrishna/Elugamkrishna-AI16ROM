file(GLOB_RECURSE FINAL_GEN_PB_SRCS
  "${CMAKE_CURRENT_SOURCE_DIR}/gen/*.pb.cc"
)

target_sources(delta_generator PRIVATE
  ${FINAL_GEN_PB_SRCS}
)

get_target_property(FINAL_UE_SOURCES delta_generator SOURCES)

list(FILTER FINAL_UE_SOURCES EXCLUDE REGEX ".*_fuzzer\\.cc$")
list(FILTER FINAL_UE_SOURCES EXCLUDE REGEX ".*_fuzzer\\.cpp$")
list(FILTER FINAL_UE_SOURCES EXCLUDE REGEX ".*/test_main\\.cc$")
list(FILTER FINAL_UE_SOURCES EXCLUDE REGEX ".*/test_main\\.cpp$")
list(FILTER FINAL_UE_SOURCES EXCLUDE REGEX ".*/.*_benchmark\\.cc$")
list(FILTER FINAL_UE_SOURCES EXCLUDE REGEX ".*/.*_benchmark\\.cpp$")

set_property(
  TARGET delta_generator
  PROPERTY SOURCES ${FINAL_UE_SOURCES}
)

target_compile_definitions(
  delta_generator PRIVATE
  __ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__
)

# AI14ROM bootimg.h compatibility header
set(AI14ROM_BOOTIMG_GEN "${CMAKE_CURRENT_SOURCE_DIR}/gen")
